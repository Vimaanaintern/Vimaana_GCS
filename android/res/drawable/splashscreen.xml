<?xml version="1.0" encoding="UTF-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
    <!-- Splash logo size: change 200dp below to make it bigger/smaller -->
    <item android:width="200dp" android:height="200dp" android:gravity="center">
        <bitmap android:src="@drawable/icon" android:gravity="fill" android:antialias="true" android:filter="true"/>
    </item>
</layer-list>
